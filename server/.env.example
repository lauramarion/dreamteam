# Copy this file to .env (same folder) and fill it in. .env is never committed.

# Shared code needed to add or change anything on the site.
# Members type it once per device, or get it pre-filled through an invite link.
# Pick something easy to type but not guessable, e.g. two or three random words.
# Changing it later just means sending the new one (or new invite links) around.
DT_GROUP_CODE=change-me
